WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "html": false,
  "contents": {
    "example": {
      "contents": {
        "schemas": {
          "baseUri": "https://example.com/",
          "path": "./schemas"
        }
      }
    }
  }
}
EOF

MAKE DIRECTORY schemas

WRITE schemas/foo.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/foo"
}
EOF

WRITE schemas/bar.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/bar"
}
EOF

WRITE schemas/baz.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/baz"
}
EOF

// It should fail with a low limit
RUN --skip-banner one.json output --maximum-direct-directory-entries 2 STDIN /dev/null IN . INTO output.txt EXPECTING 1
DROP LINES MATCHING '^2> (Writing output to:|Using configuration:|Detecting:|\([ 0-9]+%\) )' IN output.txt

WRITE expected.txt UNTIL EOF
2> error: Too many entries in a single directory
2>   at path [CWD]/output/schemas/self/v1/schemas/mcp/tools/call
2>   with count 14
EOF

REPLACE $CWD WITH '[CWD]' IN output.txt
COMPARE output.txt AGAINST expected.txt

// It should succeed without the limit
REMOVE output
RUN --skip-banner one.json output STDIN /dev/null IN . INTO log_2.txt EXPECTING 0
DROP LINES MATCHING '^[12]> \([ 0-9]+%\) ' IN log_2.txt
DROP LINES CONTAINING $ONE_PREFIX IN log_2.txt
REPLACE MATCHING ' \(#[0-9]+\)' WITH '' IN log_2.txt
REPLACE $CWD WITH '[CWD]' IN log_2.txt
SORT log_2.txt
WRITE expected_log_2.txt UNTIL EOF
2> Detecting: [CWD]/schemas/bar.json
2> Detecting: [CWD]/schemas/baz.json
2> Detecting: [CWD]/schemas/foo.json
2> Using configuration: [CWD]/one.json
2> Writing output to: [CWD]/output
EOF
COMPARE log_2.txt AGAINST expected_log_2.txt

// It should succeed when total schemas exceed the limit but are spread
// across a directory hierarchy where no single directory has more than the limit.
// The limit must be above 14 since self/v1's mcp/tools/call directory has 14 entries
// (12 per-tool subdirectories plus the generic request and response schemas)
REMOVE output
REMOVE schemas
MAKE DIRECTORY schemas/a
MAKE DIRECTORY schemas/b

WRITE schemas/a/one.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/a/one"
}
EOF

WRITE schemas/a/two.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/a/two"
}
EOF

WRITE schemas/b/three.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/b/three"
}
EOF

RUN --skip-banner one.json output --maximum-direct-directory-entries 15 STDIN /dev/null IN . INTO log_3.txt EXPECTING 0
DROP LINES MATCHING '^[12]> \([ 0-9]+%\) ' IN log_3.txt
DROP LINES CONTAINING $ONE_PREFIX IN log_3.txt
REPLACE MATCHING ' \(#[0-9]+\)' WITH '' IN log_3.txt
REPLACE $CWD WITH '[CWD]' IN log_3.txt
SORT log_3.txt
WRITE expected_log_3.txt UNTIL EOF
2> Detecting: [CWD]/schemas/a/one.json
2> Detecting: [CWD]/schemas/a/two.json
2> Detecting: [CWD]/schemas/b/three.json
2> Using configuration: [CWD]/one.json
2> Writing output to: [CWD]/output
EOF
COMPARE log_3.txt AGAINST expected_log_3.txt
