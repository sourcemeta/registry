COMPARE output.txt AGAINST expected.txt

// Run 3: change the server URL in the configuration
WRITE one.json UNTIL EOF
{
  "url": "https://other.example.com",
  "contents": {
    "example": {
      "contents": {
        "schemas": {
          "baseUri": "https://example.com/",
          "path": "./schemas"
        }
      }
    }
  }
}
EOF

// The entire thing must be invalidated because the configuration changed
RUN --skip-banner --deterministic one.json output --concurrency 1 STDIN /dev/null IN . INTO output.txt EXPECTING 0
REPLACE MATCHING ' \[[^\]\n]*[^a-z\-\n][^\]\n]*\]' WITH '' IN output.txt
