WRITE one.json UNTIL EOF
{
  "url": "https://sourcemeta.com",
  "contents": {
    "example": {
      "contents": {
        "schemas": {
          "baseUri": "https://example.com/",
          "path": "./schemas"
        }
      }
    }
  }
}
EOF

MAKE DIRECTORY schemas

WRITE schemas/foo.json UNTIL EOF
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/foo"
}
EOF

// Run 1: initial build
RUN --skip-banner --deterministic one.json output --concurrency 1 STDIN /dev/null IN . INTO log_1.txt EXPECTING 0
DROP LINES MATCHING '^[12]> \([ 0-9]+%\) ' IN log_1.txt
DROP LINES CONTAINING $ONE_PREFIX IN log_1.txt
REPLACE MATCHING ' \(#[0-9]+\)' WITH '' IN log_1.txt
REPLACE $CWD WITH '[CWD]' IN log_1.txt
SORT log_1.txt
WRITE expected_log_1.txt UNTIL EOF
2> Detecting: [CWD]/schemas/foo.json
2> Using configuration: [CWD]/one.json
2> Writing output to: [CWD]/output
EOF
COMPARE log_1.txt AGAINST expected_log_1.txt

// Run 2: cached rebuild (no changes) and resolver cache gets a hit
RUN --skip-banner --deterministic one.json output --concurrency 1 STDIN /dev/null IN . INTO output.txt EXPECTING 0
REPLACE MATCHING ' \[[^\]\n]*[^a-z\-\n][^\]\n]*\]' WITH '' IN output.txt
WRITE expected.txt UNTIL EOF
