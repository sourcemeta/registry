{
  "url": "http://localhost:8000",
  "html": {
    "name": "Keys Sandbox",
    "description": "A registry gated by machine credentials alone, with nobody to sign in interactively"
  },
  "authentication": [
    {
      "type": "apiKey",
      "algorithm": "identity",
      "name": "vault",
      "paths": [
        "/vault",
        "/self/v1/api/schemas/trace",
        "/self/v1/api/playground"
      ],
      "keys": [
        {
          "environmentVariable": "ONE_E2E_VAULT_KEY"
        }
      ]
    },
    {
      "type": "apiKey",
      "algorithm": "identity",
      "name": "ledger",
      "paths": [
        "/ledger"
      ],
      "keys": [
        {
          "environmentVariable": "ONE_E2E_LEDGER_KEY"
        }
      ]
    }
  ],
  "contents": {
    "open": {
      "baseUri": "https://example.com/open/",
      "path": "./schemas/open"
    },
    "vault": {
      "baseUri": "https://example.com/vault/",
      "path": "./schemas/vault"
    },
    "ledger": {
      "title": "Ledger",
      "baseUri": "https://example.com/ledger/",
      "path": "./schemas/ledger"
    }
  }
}
